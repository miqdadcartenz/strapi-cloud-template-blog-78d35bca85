{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage",
    "description": "Konten halaman beranda company profile"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "heroSlides": {
      "type": "component",
      "component": "home.hero-slide",
      "repeatable": true
    },
    "about": {
      "type": "component",
      "component": "home.about-section",
      "repeatable": false
    },
    "aboutStats": {
      "type": "component",
      "component": "home.stat-item",
      "repeatable": true
    },
    "produkSection": {
      "type": "component",
      "component": "home.section-produk",
      "repeatable": false
    },
    "klienSection": {
      "type": "component",
      "component": "home.section-klien",
      "repeatable": false
    },
    "klienStats": {
      "type": "component",
      "component": "home.stat-item",
      "repeatable": true
    },
    "testimoniSection": {
      "type": "component",
      "component": "home.section-testimoni",
      "repeatable": true
    },
    "galeriSection": {
      "type": "component",
      "component": "home.section-galeri",
      "repeatable": false
    },
    "artikelSection": {
      "type": "component",
      "component": "home.section-artikel",
      "repeatable": false
    },
    "sertifikatSection": {
      "type": "component",
      "component": "home.section-sertifikat",
      "repeatable": false
    },
    "featuredProducts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "homepage"
    },
    "featuredClients": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::client.client",
      "description": "Klien yang ditampilkan di beranda (optional)",
      "mappedBy": "homepage"
    },
    "featuredGallery": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gallery.gallery",
      "description": "Galeri yang ditampilkan di beranda (optional)",
      "mappedBy": "homepage"
    },
    "featuredArticles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "homepage"
    }
  }
}
